{
  "name": "lets-play-web3",
  "version": "0.1.0",
  "private": true,
  "description": "Let’s Play Web3 / 一起玩 Web3 — a free, bilingual guide to blockchains for beginners, with hands-on Sepolia testnet labs.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/binary-assets.mjs && astro dev",
    "build": "node scripts/binary-assets.mjs && node scripts/check-content.mjs && astro build && pagefind --site dist",
    "preview": "node scripts/binary-assets.mjs && astro preview",
    "diagrams": "python3 scripts/build_diagrams.py",
    "check:facts": "node scripts/check-facts.mjs",
    "check:evidence": "node scripts/check-p2-evidence.mjs",
    "appendix": "python3 scripts/gen_appendix.py",
    "check:content": "node scripts/check-content.mjs",
    "check:build": "node scripts/check-build.mjs",
    "new:chapter": "node scripts/new-chapter.mjs",
    "assets": "node scripts/binary-assets.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@types/sanitize-html": "2.16.2",
    "pagefind": "1.6.0",
    "parse5": "8.1.1",
    "sanitize-html": "2.18.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
