# PUBLIC build settings only — these are URLs, not secrets.
# Copy to .env (which is git-ignored) if you want to override locally.

# Absolute origin, no trailing slash. Used for canonical, hreflang, sitemap,
# robots.txt, Open Graph, JSON-LD and llms.txt.
SITE_URL=http://localhost:4321

# Path prefix the site is served from. '/' for local, Cloudflare Pages and
# custom domains; '/lets-play-web3/' for a GitHub *project* Pages site
# (suggested future repository name: lets-play-web3).
BASE=/

# Examples
# GitHub project Pages:  SITE_URL=https://<your-user>.github.io  BASE=/lets-play-web3/
# Cloudflare Pages:      SITE_URL=https://lets-play-web3.pages.dev  BASE=/

# Optional: public source repository, shown as "Report a problem" in the footer
# and on the accessibility page. Empty = default https://github.com/cnkang/lets-play-web3
# (the GitHub Pages workflow sets it from the repository automatically).
REPO_URL=

# Optional: name shown as the compiler/author (schema.org Person).
# Empty = default "Kang".
AUTHOR_NAME=
