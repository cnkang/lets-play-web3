# dependencies
node_modules/

# Astro build output and caches
dist/
.astro/
.cache/
.indexnow/
*.tsbuildinfo

# secrets — never commit any of these
.env
.env.*
!.env.example
.secrets/
*.key
*.pem
*.p12
accounts.secret*.json

# Open Graph PNGs are decoded from assets/og/*.png.b64 by scripts/binary-assets.mjs
# (runs automatically before dev/build/preview); the .b64 files are tracked.
public/og/*.png

# local oracle replay output (a new run is not the saved historical evidence)
/labs/local-oracle/node_modules/
/labs/local-oracle/artifacts/
/labs/local-oracle/compiler-cache/
/labs/local-oracle/out/
/labs/local-oracle/evidence/
/labs/local-oracle/evidence-*/
/labs/local-oracle/LOCAL-ORACLE-LAB-REPORT.md
/labs/local-oracle/MANIFEST.sha256

# local tooling / OS noise
/IDEA.md
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.vscode/
.idea/
/tmp/
