---
// Root: a language-neutral entry. With JS it picks an edition:
//   1. an explicit choice saved by the language switcher (localStorage 'lang'),
//   2. otherwise the first zh*/en* tag in navigator.languages,
//   3. otherwise English (readers whose browser is neither zh nor en).
// Without JS (and for crawlers that don't run it), the page remains a neutral
// language chooser with visible links to both editions. Language pages themselves
// never auto-redirect.
import '../styles/global.css'
import { href, absolute } from '../data/site'
const zh = href('zh/')
const en = href('en/')
const routes = JSON.stringify({ zh, en })
---
<!doctype html>
<html lang="zh-CN" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>一起玩 Web3 · Let’s Play Web3</title>
    <meta name="description" content="一起玩 Web3 / Let’s Play Web3：中英双语区块链入门教材（仅 Sepolia 测试网）。" />
    <link rel="canonical" href={absolute('zh/')} />
    <link rel="alternate" hreflang="zh-CN" href={absolute('zh/')} />
    <link rel="alternate" hreflang="en" href={absolute('en/')} />
    <link rel="alternate" hreflang="x-default" href={absolute('zh/')} />
    <script is:inline define:vars={{ routes }}>
      (function () {
        var r = JSON.parse(routes), pick = null
        try { var s = localStorage.getItem('lang'); if (s === 'zh' || s === 'en') pick = s } catch (e) {}
        if (!pick) {
          var l = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''])
          for (var i = 0; i < l.length && !pick; i++) {
            var t = String(l[i]).toLowerCase()
            if (t === 'zh' || t.indexOf('zh-') === 0) pick = 'zh'
            else if (t === 'en' || t.indexOf('en-') === 0) pick = 'en'
          }
        }
        location.replace(r[pick || 'en'] + location.search + location.hash)
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body>
    <main id="main" class="shell">
      <h1>一起玩 Web3 · <span lang="en">Let’s Play Web3</span></h1>
      <p>免费的中英双语入门站。阅读教材，或在浏览器里练习授权、兑换和哈希链。不需要钱包，也不花真钱。</p>
      <p lang="en">A free bilingual introduction. Read the book, or practice allowances, swaps, and hash chains in the browser. No wallet and no real money.</p>
      <ul>
        <li><a href={zh} hreflang="zh-CN" data-lang-choice="zh">进入中文版</a></li>
        <li><a href={en} lang="en" hreflang="en" data-lang-choice="en">Read in English</a></li>
        <li><a href={href('zh/labs/')} hreflang="zh-CN">中文互动实验</a> · <a href={href('en/labs/')} lang="en" hreflang="en">English labs</a></li>
        <li><a href={href('zh/guides/')} hreflang="zh-CN">中文问题指南</a> · <a href={href('en/guides/')} lang="en" hreflang="en">English guides</a></li>
        <li><a href={href('zh/learn-with-ai/')} hreflang="zh-CN">请 AI 带练</a> · <a href={href('en/learn-with-ai/')} lang="en" hreflang="en">Learn with an AI agent</a></li>
      </ul>
      <p>有 JavaScript 时，本页会按已保存的语言或浏览器语言进入中文版或英文版。没有 JavaScript 时，请使用上面的链接。中文版和英文版本身不会自动跳转。</p>
    </main>
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('[data-lang-choice]')
        if (a) try { localStorage.setItem('lang', a.getAttribute('data-lang-choice')) } catch (err) {}
      })
    </script>
  </body>
</html>
