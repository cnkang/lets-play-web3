---
import '../../../styles/labs.css'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Crumb from '../../../components/Crumb.astro'
import { labs } from '../../../data/labs-copy.mjs'
import { ui, langs, type Lang } from '../../../data/book'
import { absolute, authorLd, href, htmlLang } from '../../../data/site'

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }))
}
const { lang } = Astro.params as { lang: Lang }
const zh = lang === 'zh'
const title = zh ? '互动实验' : 'Interactive labs'
const description = zh
  ? '三个只在浏览器里运行的实验：授权额度、恒定乘积兑换，以及 SHA-256 哈希链。不需要钱包，也不花真钱。'
  : 'Three browser-only labs: an ERC-20 allowance, a constant-product swap, and a SHA-256 hash chain. No wallet and no real money.'
const path = 'labs/'
const site = ui[lang].siteTitle
const pageUrl = absolute(`${lang}/${path}`)
const ids = ['erc20-allowance', 'constant-product-amm', 'hash-chain']
const cards = ids.map((id) => ({ id, copy: labs[id][lang] }))
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: htmlLang[lang],
    isPartOf: { '@type': 'WebSite', name: site, url: absolute(`${lang}/`) },
    author: authorLd(lang)
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site, item: absolute(`${lang}/`) },
      { '@type': 'ListItem', position: 2, name: title, item: pageUrl }
    ]
  }
]
---
<BaseLayout lang={lang} title={title} description={description} path={path} jsonLd={jsonLd} navKey="labs">
  <article class="shell lab-page" data-pagefind-body>
    <Crumb lang={lang} items={[{ href: `${lang}/`, name: site }, { name: title }]} />
    <p class="kicker">{zh ? '亲手试，不签名' : 'Practice here. Sign nothing.'}</p>
    <h1>{title}</h1>
    <p>{zh
      ? '这三个实验都在你的浏览器里计算。它们不是 Sepolia 上的交易，也不是书里的历史记录。书里的交易仍然是证据。这里是练习。'
      : 'These three labs calculate in your browser. They are not Sepolia transactions, and they are not the book’s historical records. The book’s transactions remain the evidence. This section is practice.'}</p>
    <ul class="cards">
      {cards.map((card) => (
        <li class="card">
          <h2><a href={href(`${lang}/labs/${card.id}/`)}>{card.copy.title}</a></h2>
          <p>{card.copy.description}</p>
        </li>
      ))}
    </ul>
    <p>
      <a class="btn ghost" href={href(`${lang}/guides/`)}>{zh ? '先看问题指南' : 'Read a question guide'}</a>
      <a class="btn ghost" href={href(`${lang}/learn-with-ai/`)}>{zh ? '请 AI 带练' : 'Learn with an AI agent'}</a>
    </p>
  </article>
</BaseLayout>
