---
import Nw from '../../components/Nw.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BookToc from '../../components/BookToc.astro'
import SafetyNotice from '../../components/SafetyNotice.astro'
import Snapshot from '../../components/Snapshot.astro'
import { ui, langs, type Lang } from '../../data/book'
import { href, absolute, htmlLang, authorLd } from '../../data/site'

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }))
}
const { lang } = Astro.params as { lang: Lang }
const t = ui[lang]
const zh = lang === 'zh'
const description = zh
  ? '免费的中英双语区块链入门指南：从生活例子理解什么时候需要区块链，再打开 Sepolia 测试网交易记录，观察实验里实际发生了什么。阅读无需钱包。'
  : 'A free, bilingual guide to blockchains for beginners. Learn through everyday examples, then inspect real Sepolia testnet transactions. No wallet needed to read.'
const cards = zh
  ? [
      { t: '先问「为什么需要」', d: '用社区积分、商场联合收银、自动售货机这些日常场景，弄清区块链什么时候值得用、什么时候不值得。', s: '02-who-needs-blockchain' },
      { t: '打开记录，看实际发生了什么', d: '从 Counter 计数器开始，看交易是否成功、记录了什么变化。地址和交易都链接到 Sepolia Etherscan，一个公开查询链上记录的网站。', s: '08-lab-counter' },
      { t: '把安全习惯练成肌肉记忆', d: '授权不是付款；转错地址无法找回；可升级意味着管理员权力；测试全过也不等于没有漏洞。', s: '10-approve-vs-payment' },
      { t: '基础已完成，DeFi 还没开始', d: 'Phase-0 基础实验与复核已结束。Phase-1 DeFi 是下一步计划，会作为新章节加入；目前没有 DeFi 实验结果。', s: '19-next-p1-defi' }
    ]
  : [
      { t: 'Ask "why" before "how"', d: 'Community points, a shared mall checkout, a vending machine: everyday scenes that show when a blockchain is worth it and when it is not.', s: '02-who-needs-blockchain' },
      { t: 'Open a record and see what happened', d: 'Start with Counter: check whether a transaction succeeded and what changed. Addresses and transactions link to Sepolia Etherscan, a public explorer.', s: '08-lab-counter' },
      { t: 'Turn safety into habit', d: 'Approval is not payment; a wrong address cannot be undone; upgradeable means an admin holds power; passing tests do not prove there are no bugs.', s: '10-approve-vs-payment' },
      { t: 'Basics complete; DeFi comes next', d: 'Phase-0 basics, experiments and review are complete. Phase-1 DeFi has not started. Its future experiments will become new chapters.', s: '19-next-p1-defi' }
    ]
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t.siteTitle,
    alternateName: zh ? 'Let’s Play Web3' : '一起玩 Web3',
    url: absolute(`${lang}/`),
    description,
    inLanguage: htmlLang[lang],
    publisher: authorLd(lang),
    potentialAction: {
      '@type': 'SearchAction',
      target: absolute(`${lang}/search/`) + '?q={search_term_string}',
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: t.siteTitle,
    inLanguage: htmlLang[lang],
    url: absolute(`${lang}/`),
    bookFormat: 'https://schema.org/EBook',
    isAccessibleForFree: true,
    author: authorLd(lang),
    workTranslation: { '@type': 'Book', name: zh ? 'Let’s Play Web3' : '一起玩 Web3', inLanguage: zh ? 'en' : 'zh-CN', url: absolute(`${zh ? 'en' : 'zh'}/`) }
  }
]
---
<BaseLayout lang={lang} title={t.siteTitle} description={description} path="" jsonLd={jsonLd}>
  <section class="hero-band" aria-labelledby="hero-title">
   <div class="hero-deco" aria-hidden="true"><span class="glow"></span><span class="d1"></span><span class="d2"></span><span class="d3"></span><span class="d4"></span></div>
   <div class="hero">
    <div>
      <p class="kicker"><span class="pill">{t.siteTitle}</span><span>{zh ? '免费入门指南 · 中英双语 · 测试网实验' : 'A hands-on guide for beginners · Free · Bilingual'}</span></p>
      <h1 id="hero-title">{t.siteTagline}</h1>
      <p class="sub">
        {zh
          ? '会用电脑、会上网，却不知道区块链有什么用？从几家店共用积分这样的例子出发，分清什么时候需要区块链、什么时候普通数据库就够了。再跟着真实实验，看懂交易、合约和授权。实验使用 Sepolia——以太坊专门用来练习的测试网，预算 $0。遇到生词，点旁边的 ?。'
          : 'Comfortable with a computer, but new to blockchains? Start with everyday examples to learn when a blockchain helps and when a database is enough. Then follow real experiments to understand transactions, contracts and approvals. The labs used Sepolia, Ethereum’s practice network, with a $0 budget. Press ? beside a new term for an explanation.'}
      </p>
      <div class="btn-row">
        <a class="btn primary" href={href(`${lang}/chapters/01-how-to-read/`)}>{zh ? '从第 1 章开始读' : 'Start with Chapter 1'}</a>
        <a class="btn ghost" href={href(`${lang}/chapters/08-lab-counter/#inspect-a-transaction`)}>{zh ? '看一笔测试网交易' : 'Inspect a testnet transaction'}</a>
      </div>
      <p><Nw text={zh ? '只想先看看？第二个入口会带你核对交易状态、代币转账和事件。无需连接钱包、领币或注册账号。' : 'Just looking? The second link walks you through status, token transfers and an event. No wallet connection, faucet or account needed.'} /></p>
    </div>
    <div class="hero-art">
      <img src={href(`diagrams/${lang}/counter.svg`)} width="960" height="540"
        alt={zh ? 'Counter 实验：计数从 0 加到 1，清零，再加到 2；每一步都留下交易记录，清零不会抹掉历史。' : 'The Counter lab: the count rises from 0 to 1, resets, then reaches 2. Each step leaves a transaction record; resetting does not erase history.'} />
    </div>
   </div>
  </section>

  <div class="home-section notes-stack">
    <SafetyNotice lang={lang} />
    <Snapshot lang={lang} />
  </div>

  <section class="home-section" aria-labelledby="why-title">
    <h2 id="why-title">{zh ? '这本书有什么不同' : 'What makes this book different'}</h2>
    <ul class="cards">
      {cards.map((c) => (
        <li class="card">
          <h3><a href={href(`${lang}/chapters/${c.s}/`)}>{c.t}</a></h3>
          <p><Nw text={c.d} /></p>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="contents-title">
    <h2 id="contents-title">{zh ? '目录' : 'Contents'}</h2>
    <div class="home-toc-wrap">
      <BookToc lang={lang} idPrefix="home-toc" />
    </div>
  </section>
</BaseLayout>
