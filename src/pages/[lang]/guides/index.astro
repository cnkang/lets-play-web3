---
import '../../../styles/labs.css'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Crumb from '../../../components/Crumb.astro'
import { guides } from '../../../data/guides.mjs'
import { ui, langs, type Lang } from '../../../data/book'
import { absolute, href, htmlLang } from '../../../data/site'

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }))
}
const { lang } = Astro.params as { lang: Lang }
const zh = lang === 'zh'
const title = zh ? '问题指南' : 'Question guides'
const description = zh
  ? '五个从具体问题出发的短指南：授权、资金池定价、合约升级、清算，以及怎样不花真钱学习。'
  : 'Five short guides that start from a question: approvals, pool prices, upgrades, liquidation, and learning without real money.'
const path = 'guides/'
const site = ui[lang].siteTitle
const pageUrl = absolute(`${lang}/${path}`)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: htmlLang[lang],
    isPartOf: { '@type': 'WebSite', name: site, url: absolute(`${lang}/`) }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site, item: absolute(`${lang}/`) },
      { '@type': 'ListItem', position: 2, name: title, item: pageUrl }
    ]
  }
]
---
<BaseLayout lang={lang} title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="shell lab-page" data-pagefind-body>
    <Crumb lang={lang} items={[{ href: `${lang}/`, name: site }, { name: title }]} />
    <h1>{title}</h1>
    <p>{zh
      ? '每一篇都先回答问题，再指向已有的章节和浏览器实验。它们不是新的教材章节，也不重复整章内容。'
      : 'Each guide answers the question first, then points to a chapter and, where it helps, a browser lab. These are not new textbook chapters, and they do not repeat a whole chapter.'}</p>
    <ul class="cards">
      {guides.map((guide) => (
        <li class="card">
          <h2><a href={href(`${lang}/guides/${guide.slug}/`)}>{guide[lang].title}</a></h2>
          <p>{guide[lang].description}</p>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
