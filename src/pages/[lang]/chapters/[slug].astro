---
import Nw from '../../../components/Nw.astro'
import { render } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import BookToc from '../../../components/BookToc.astro'
import NumLabel from '../../../components/NumLabel.astro'
import Addr from '../../../components/Addr.astro'
import Tx from '../../../components/Tx.astro'
import Figure from '../../../components/Figure.astro'
import Callout from '../../../components/Callout.astro'
import T from '../../../components/T.astro'
import SafetyNotice from '../../../components/SafetyNotice.astro'
import Snapshot from '../../../components/Snapshot.astro'
import Quiz from '../../../components/Quiz.astro'
import Lab from '../../../components/Lab.astro'
import Term from '../../../components/Term.astro'
import Glossary from '../../../components/Glossary.astro'
import { ui, langs, type Lang } from '../../../data/book'
import { getBook, partOf } from '../../../data/chapters'
import { href, absolute, htmlLang, authorFor, authorLd, PUBLISHED, SNAPSHOT_ISO } from '../../../data/site'
import { quiz } from '../../../data/quiz'

export async function getStaticPaths() {
  // One page per language for every published (or, in dev, draft) chapter.
  const book = await getBook()
  return book.pages.flatMap((c) => langs.map((lang) => ({ params: { lang, slug: c.slug }, props: { entry: c.entries[lang] } })))
}

const { entry } = Astro.props
const { lang, slug } = Astro.params as { lang: Lang; slug: string }
const t = ui[lang]
const { Content, headings } = await render(entry)
const book = await getBook()
const idx = book.pages.findIndex((c) => c.slug === slug)
const prev = idx > 0 ? book.pages[idx - 1] : undefined
const next = idx < book.pages.length - 1 ? book.pages[idx + 1] : undefined
const part = partOf(book, slug)
const isDraft = entry.data.status === 'draft'
const modified = entry.data.updated ?? PUBLISHED
const snap = entry.data.snapshot ?? { at: SNAPSHOT_ISO, block: 12117419 }
const snapLabel = `${snap.at.slice(0, 10)} ${snap.at.slice(11, 19)} (UTC+8)`
const author = authorLd(lang)
const byline = authorFor(lang)
const title = entry.data.title
const path = `chapters/${slug}/`
const headingList = headings.filter((h) => h.depth === 2 || h.depth === 3)
// The first section of Chapter 8 is a raw <h2 id> in the MDX, which Astro's
// heading extraction does not list. Add it explicitly so the on-page TOC shows
// the published anchor before the nested terminal subsection in both editions.
const extraToc = slug === '08-lab-counter' && !headingList.some((h) => h.slug === 'inspect-a-transaction')
  ? [{ depth: 2, slug: 'inspect-a-transaction', text: lang === 'zh' ? '先看一笔交易：不用钱包的练习' : 'Inspect a transaction without a wallet' }]
  : []
const toc = [...extraToc, ...headingList]

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': ['TechArticle', 'LearningResource'],
    headline: title,
    name: title,
    description: entry.data.description,
    inLanguage: htmlLang[lang],
    url: absolute(`${lang}/${path}`),
    mainEntityOfPage: absolute(`${lang}/${path}`),
    datePublished: PUBLISHED,
    dateModified: modified,
    author,
    publisher: author,
    image: absolute(`og/${lang}.png`),
    learningResourceType: lang === 'zh' ? '教材章节' : 'Textbook chapter',
    educationalLevel: lang === 'zh' ? '初学者' : 'Beginner',
    isAccessibleForFree: true,
    temporalCoverage: snap.at,
    about: ['Ethereum Sepolia testnet', 'smart contracts', 'ERC-20'],
    isPartOf: { '@type': 'WebSite', name: t.siteTitle, url: absolute(`${lang}/`) }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.siteTitle, item: absolute(`${lang}/`) },
      { '@type': 'ListItem', position: 2, name: title, item: absolute(`${lang}/${path}`) }
    ]
  }
]
if (slug === '18-glossary-quiz') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: htmlLang[lang],
    mainEntity: quiz[lang].map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } }))
  })
}
// Every MDX component is available in every chapter without an import.
const components = { Addr, Tx, Figure, Callout, T, SafetyNotice, Snapshot, Quiz, Lab, Term, Glossary }
---
<BaseLayout lang={lang} title={title} description={entry.data.description} path={path} jsonLd={jsonLd} ogType="article" currentSlug={slug} noindex={isDraft}
  navKey={slug === '16-appendix-addresses-txs' ? 'appendix' : slug === '18-glossary-quiz' ? 'glossary' : slug === '01-how-to-read' ? 'start' : undefined}>
  <div class="shell chapter-grid">
    <aside class="sidebar">
      <BookToc lang={lang} current={slug} idPrefix="side-toc" />
    </aside>
    <article class="article" aria-labelledby="chapter-title" data-pagefind-body>
      <header class="article-head">
        <p class="eyebrow">{part?.[lang]}</p>
        {isDraft && <p class="callout warn">{lang === 'zh' ? '草稿：只在本地开发模式可见，正式构建不会包含本章。' : 'Draft: visible in local dev only; production builds leave this chapter out.'}</p>}
        <h1 id="chapter-title"><Nw text={title} /></h1>
        <p class="meta-line">
          <span>{lang === 'zh' ? `整理：${byline}` : `By ${byline}`}</span>
          <span>{lang === 'zh' ? '页面发布：' : 'Published: '}<time class="nw" datetime={PUBLISHED}>{PUBLISHED}</time>{modified !== PUBLISHED && <> · <span class="nw">{lang === 'zh' ? '更新：' : 'Updated: '}<time datetime={modified}>{modified}</time></span></>}</span>
          <span>{lang === 'zh' ? '链上快照：' : 'Chain snapshot: '}<time datetime={snap.at}>{snapLabel}</time>{lang === 'zh' ? <>，<span class="nw">区块 {snap.block}</span></> : <>, <span class="nw">block {snap.block}</span></>}</span>
        </p>
      </header>
      <div class="prose">
        <Content components={components} />
      </div>
      <nav class="pager" aria-label={lang === 'zh' ? '章节翻页' : 'Chapter navigation'}>
        {prev ? <a class="prev" href={href(`${lang}/chapters/${prev.slug}/`)} rel="prev"><span class="dir">← {t.prev}</span><span class="ttl num-item"><NumLabel label={prev.nav[lang]} /></span></a> : <span />}
        {next && <a class="next" href={href(`${lang}/chapters/${next.slug}/`)} rel="next"><span class="dir">{t.next} →</span><span class="ttl num-item"><NumLabel label={next.nav[lang]} /></span></a>}
      </nav>
      <p class="kbd-hint" data-js-only hidden>
        <span class="kbd-on">{lang === 'zh' ? <>快捷键：<kbd>←</kbd> <kbd>→</kbd> 翻章</> : <>Shortcut: <kbd>←</kbd> <kbd>→</kbd> to change chapter</>}</span>
        <span class="kbd-off">{lang === 'zh' ? '单键快捷键已关闭' : 'Single-key shortcuts are off'}</span>
        <span aria-hidden="true"> · </span>
        <button type="button" class="link-btn" data-kbd-help aria-haspopup="dialog">{lang === 'zh' ? '全部快捷键与开关' : 'All shortcuts & on/off'}</button>
      </p>
    </article>
    {toc.length > 1 && (
      <details class="onpage" id="onpage">
        <summary id="onpage-title">{t.onThisPage}</summary>
        <nav class="onpage-nav" aria-labelledby="onpage-title">
          <ol>
            {toc.map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      </details>
    )}
  </div>
</BaseLayout>
