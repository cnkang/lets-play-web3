---
// Same local parameters. Only the valuation source changes.
// "Borrowing limit" here is collateral value times the 75% LTV. It is not an Aave reserve borrow cap.
const zh = !Astro.url.pathname.includes('/en/')
const cards = zh
  ? [
      {
        title: '借贷合约直接读薄池现价',
        prices: ['起点 1', '峰值约 3.605', '结束约 2.045'],
        rows: [
          ['采用的价格', '3.604869999999999999'],
          ['按 75% 贷款价值比的借款限额', '8,110.957499999999997750'],
          ['实际留下的普通债务', '8,000'],
          ['锁住、不能再卖的抵押', '3,000'],
          ['结束时的池价', '2.045236389923581453'],
          ['模拟者余额', '3,678.345270534929823185'],
          ['锚价 1 下的抵押不足', '5,000'],
          ['未执行的回收报价缺口', '3,714.031198495643589346']
        ],
        note: '8,000、5,000 和约 3,714 不是三笔已经实现的亏损。闪贷本金和 5 单位手续费已经归还。'
      },
      {
        title: '独立固定价，不跟这笔交易变化',
        prices: ['锚价保持 1', '薄池峰值只出现在回滚前', '结束后仍是 1'],
        rows: [
          ['采用的价格', '1'],
          ['按 75% 贷款价值比的借款限额', '2,250'],
          ['实际留下的普通债务', '0'],
          ['锁住的抵押', '0'],
          ['结束时的池价', '1'],
          ['模拟者余额', '0'],
          ['锚价 1 下的抵押不足', '0'],
          ['报价缺口', '0']
        ],
        note: '同样请求借 8,000，被 BorrowLimit 拒绝。资金状态撤销。nonce 加 1，gas 为 0.000258899 mock ETH。'
      }
    ]
  : [
      {
        title: 'The lender reads the thin-pool spot',
        prices: ['Start 1', 'Peak about 3.605', 'End about 2.045'],
        rows: [
          ['Price used', '3.604869999999999999'],
          ['Borrowing limit at the 75% LTV', '8,110.957499999999997750'],
          ['Ordinary debt left', '8,000'],
          ['Locked collateral, not sold again', '3,000'],
          ['Pool price at the end', '2.045236389923581453'],
          ['Simulator balance', '3,678.345270534929823185'],
          ['Shortfall at anchor price 1', '5,000'],
          ['Unexecuted recovery-quote gap', '3,714.031198495643589346']
        ],
        note: '8,000, 5,000 and about 3,714 are not three realized losses. The flash-loan principal and the fee of 5 are repaid.'
      },
      {
        title: 'Independent fixed price',
        prices: ['Anchor stays 1', 'The peak exists only before rollback', 'The end price is still 1'],
        rows: [
          ['Price used', '1'],
          ['Borrowing limit at the 75% LTV', '2,250'],
          ['Ordinary debt left', '0'],
          ['Locked collateral', '0'],
          ['Pool price at the end', '1'],
          ['Simulator balance', '0'],
          ['Shortfall at anchor price 1', '0'],
          ['Quote gap', '0']
        ],
        note: 'The same request for 8,000 fails with BorrowLimit. Fund state reverts. The nonce increases by 1. Gas is 0.000258899 mock ETH.'
      }
    ]
---
<figure class="scene">
  <div class="scene-set">
    <p class="scene-legend">{zh
      ? '两列使用同一套数量。借款限额是「抵押估值 × 75%」，不是 Aave 储备上的 borrow cap。固定价 1 只是这笔交易改不到的教学锚。'
      : 'Both columns use the same amounts. The borrowing limit is collateral value times 75%. It is not an Aave reserve borrow cap. The fixed price of 1 is only a teaching anchor this trade cannot move.'}</p>
    <div class="scene-grid scene-grid-2">
      {cards.map((card) => (
        <article class="scene-card">
          <h3 class="scene-title">{card.title}</h3>
          <ol class="price-path">
            {card.prices.map((price) => <li>{price}</li>)}
          </ol>
          <dl class="scene-dl">
            {card.rows.map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))}
          </dl>
          <p>{card.note}</p>
        </article>
      ))}
    </div>
  </div>
  <figcaption>
    <strong>{zh ? '图 19-1｜' : 'Figure 19-1 · '}</strong>
    {zh
      ? '脆弱路径的池价从 1 被推到约 3.60，结束时约 2.05，因为 3,000 抵押币没有卖回池中。对照路径的估值保持 1，同样的 8,000 请求不会留下债务。'
      : 'On the fragile path the pool price moves from 1 to about 3.60 and ends near 2.05, because 3,000 collateral tokens are not sold back. On the control path the valuation stays at 1, and the same request for 8,000 leaves no debt.'}
  </figcaption>
</figure>
