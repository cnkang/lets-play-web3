---
import Nw from '../components/Nw.astro'
import '../styles/global.css'
import { ui, type Lang } from '../data/book'
import { href, absolute, htmlLang, ogLocale, authorFor, REPO_URL } from '../data/site'
import BookToc from '../components/BookToc.astro'

interface Props {
  lang: Lang
  title: string
  description: string
  /** Path without the language prefix, e.g. 'chapters/08-lab-counter/' or '' for home. */
  path: string
  jsonLd?: object[]
  ogType?: 'website' | 'article'
  currentSlug?: string
  /** which top-nav item is current */
  navKey?: 'start' | 'appendix' | 'glossary' | 'search' | 'a11y'
  noindex?: boolean
}
const { lang, title, description, path, jsonLd = [], ogType = 'website', currentSlug, navKey, noindex = false } = Astro.props
const t = ui[lang]
const other: Lang = lang === 'zh' ? 'en' : 'zh'
const selfUrl = absolute(`${lang}/${path}`)
const zhUrl = absolute(`zh/${path}`)
const enUrl = absolute(`en/${path}`)
const otherHref = href(`${other}/${path}`)
const fullTitle = path === '' ? `${t.siteTitle} · ${t.siteTagline}` : `${title} · ${t.siteTitle}`
const ogImage = absolute(`og/${lang}.png`)
const ogAlt = lang === 'zh' ? '一起玩 Web3：从生活理解区块链，再在 Sepolia 测试网上亲手验证' : 'Let’s Play Web3: understand blockchains through everyday life, then verify on the Sepolia testnet'
const author = authorFor(lang)
const nav = [
  { key: 'start', text: t.start, href: href(`${lang}/chapters/01-how-to-read/`) },
  { key: 'appendix', text: t.appendix, href: href(`${lang}/chapters/16-appendix-addresses-txs/`) },
  { key: 'glossary', text: t.glossary, href: href(`${lang}/chapters/18-glossary-quiz/`) },
  { key: 'search', text: t.search, href: href(`${lang}/search/`) }
]
const a11yHref = href(`${lang}/accessibility/`)
---
<!doctype html>
<html lang={htmlLang[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={selfUrl} />
    {!noindex && <link rel="alternate" hreflang="zh-CN" href={zhUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={zhUrl} />}
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="sitemap" href={href('sitemap.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={href('llms.txt')} />
    <meta name="theme-color" content="#f6f5fe" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100d22" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.siteTitle} />
    <meta property="og:title" content={path === '' ? t.siteTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={selfUrl} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={path === '' ? t.siteTitle : title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : { '@context': 'https://schema.org', '@graph': jsonLd })} />}

    <script is:inline>
      // Apply saved / system theme before paint (no flash). Light is the default.
      (function () {
        document.documentElement.classList.add('js')
        try {
          var s = localStorage.getItem('theme')
          var dark = s ? s === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
          if (dark) document.documentElement.setAttribute('data-theme', 'dark')
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={href(`${lang}/`)} aria-current={path === '' ? 'page' : undefined}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="brand-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7b4dff" />
                <stop offset="1" stop-color="#4218c2" />
              </linearGradient>
            </defs>
            <rect x="1" y="1" width="30" height="30" rx="9" fill="url(#brand-grad)" />
            <path d="M12.5 9.6v12.8a1 1 0 0 0 1.5.86l10.2-6.4a1 1 0 0 0 0-1.72L14 8.74a1 1 0 0 0-1.5.86Z" fill="#ffffff" />
            <circle cx="25" cy="25" r="3.6" fill="#ff7a59" stroke="#ffffff" stroke-width="1.6" />
          </svg>
          <span class="brand-text">{t.brandLead} <span class="brand-accent">{t.brandAccent}</span></span>
        </a>
        <nav class="main-nav" aria-label={lang === 'zh' ? '主导航' : 'Main'}>
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={navKey === n.key ? 'page' : undefined}>{n.text}</a></li>)}
          </ul>
        </nav>
        <div class="header-tools">
          <a class="lang-switch" href={otherHref} hreflang={htmlLang[other]} data-lang-choice={other}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" /></svg>
            <span class="label-text" lang={htmlLang[other]}>{t.switchTo}</span>
            <span class="label-short" lang={htmlLang[other]}>{lang === 'zh' ? 'EN' : '中'}</span>
            <span class="visually-hidden">{lang === 'zh' ? '（切换到本页的英文版本）' : ' (switch to the Chinese version of this page)'}</span>
          </a>
          <button type="button" class="tool-btn theme-toggle" aria-pressed="false" data-label-light={lang === 'zh' ? '深色模式' : 'Dark mode'} aria-label={lang === 'zh' ? '深色模式' : 'Dark mode'}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          </button>
          <button type="button" class="tool-btn menu-btn" aria-expanded="false" aria-controls="menu-panel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <span class="label-text">{t.menu}</span>
          </button>
        </div>
      </div>
    </header>

    {/* Language hint: shown by JS only when the browser prefers the other edition
        and the reader has not chosen a language yet. Never redirects. */}
    <aside class="lang-hint" id="lang-hint" lang={htmlLang[other]} aria-labelledby="lang-hint-text" hidden>
      <div class="lang-hint-inner">
        <p id="lang-hint-text">{other === 'zh' ? '本页也有中文版。' : 'This page is also available in English.'}</p>
        <a class="lang-hint-go" href={otherHref} hreflang={htmlLang[other]} data-lang-choice={other}>{other === 'zh' ? '阅读中文版' : 'Read in English'}</a>
        <button type="button" class="lang-hint-close" data-lang-stay={lang}>
          <span aria-hidden="true">×</span><span class="visually-hidden">{other === 'zh' ? '关闭提示，继续读英文版' : 'Dismiss and keep reading in Chinese'}</span>
        </button>
      </div>
    </aside>

    <div class="menu-panel" id="menu-panel" data-open="false" hidden>
      <div class="menu-backdrop" data-close></div>
      <div class="menu-sheet" role="dialog" aria-modal="true" aria-labelledby="menu-title">
        <div class="menu-sheet-head">
          <h2 id="menu-title">{t.menu}</h2>
          <button type="button" class="tool-btn" data-close aria-label={lang === 'zh' ? '关闭菜单' : 'Close menu'}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
        <nav aria-label={lang === 'zh' ? '快捷导航' : 'Quick links'}>
          <ul class="menu-quick">
            <li><a href={href(`${lang}/`)} aria-current={path === '' ? 'page' : undefined}>{lang === 'zh' ? '首页' : 'Home'}</a></li>
            {nav.map((n) => <li><a href={n.href} aria-current={navKey === n.key ? 'page' : undefined}>{n.text}</a></li>)}
          </ul>
        </nav>
        <BookToc lang={lang} current={currentSlug} idPrefix="menu-toc" />
      </div>
    </div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p><Nw text={t.footer} /></p>
        <p><Nw text={t.snapshot} /></p>
        <p><Nw text={lang === 'zh' ? `整理：${author}（个人学习项目）· 页面发布于 2026-11-13` : `Compiled by ${author} (a personal study project) · Pages published 2026-11-13`} /></p>
        <ul class="footer-links" aria-label={lang === 'zh' ? '页脚链接' : 'Footer links'}>
          <li><a href={a11yHref} aria-current={navKey === 'a11y' ? 'page' : undefined}>{lang === 'zh' ? '无障碍声明与问题反馈' : 'Accessibility statement & feedback'}</a></li>
          {REPO_URL && <li><a href={`${REPO_URL}/issues`}>{lang === 'zh' ? '报告问题（GitHub Issues）' : 'Report a problem (GitHub Issues)'}</a></li>}
          <li><a href={href('llms.txt')}>llms.txt</a></li>
          <li><a href={href('sitemap.xml')}>{lang === 'zh' ? '站点地图' : 'Sitemap'}</a></li>
          <li data-js-only hidden><button type="button" class="link-btn" data-kbd-help aria-haspopup="dialog">{lang === 'zh' ? '键盘快捷键' : 'Keyboard shortcuts'}</button></li>
        </ul>
      </div>
    </footer>

    {/* Keyboard shortcuts help (native modal <dialog>: focus containment, Esc, focus return) */}
    <dialog id="kbd-help" class="kbd-help" aria-labelledby="kbd-help-title" closedby="any">
      <div class="kbd-help-head">
        <h2 id="kbd-help-title">{lang === 'zh' ? '键盘快捷键' : 'Keyboard shortcuts'}</h2>
        <form method="dialog"><button type="submit" class="tool-btn" aria-label={lang === 'zh' ? '关闭键盘快捷键说明' : 'Close keyboard shortcuts'}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg></button></form>
      </div>
      <table class="kbd-table">
        <caption class="visually-hidden">{lang === 'zh' ? '按键与作用' : 'Keys and what they do'}</caption>
        <thead><tr><th scope="col">{lang === 'zh' ? '按键' : 'Key'}</th><th scope="col">{lang === 'zh' ? '作用' : 'Action'}</th></tr></thead>
        <tbody>
          <tr><td><kbd>←</kbd> <kbd>→</kbd></td><td>{lang === 'zh' ? '上一章 / 下一章（只在章节页）' : 'Previous / next chapter (chapter pages only)'}</td></tr>
          <tr><td><kbd>/</kbd></td><td>{lang === 'zh' ? '打开搜索' : 'Open search'}</td></tr>
          <tr><td><kbd>?</kbd></td><td>{lang === 'zh' ? '打开这份说明' : 'Open this list'}</td></tr>
          <tr><td><kbd>Esc</kbd></td><td>{lang === 'zh' ? '关闭说明、菜单或术语小窗' : 'Close this list, the menu or a glossary popup'}</td></tr>
          <tr><td><kbd>Tab</kbd> / <kbd>Shift</kbd>+<kbd>Tab</kbd></td><td>{lang === 'zh' ? '在链接和按钮之间前后移动' : 'Move between links and buttons'}</td></tr>
        </tbody>
      </table>
      <p class="kbd-help-note">{lang === 'zh' ? '在输入框里打字、选中文字、按住 Ctrl / Alt / ⌘ / Shift，或焦点在可以左右滚动的表格、代码、示意图里时，← → 不会翻章。' : 'Arrow keys never change the chapter while you type in a field, select text, hold Ctrl / Alt / ⌘ / Shift, or while focus is in a table, code block or diagram that scrolls sideways.'}</p>
      <label class="kbd-toggle"><input type="checkbox" id="kbd-enabled" autofocus /> <span>{lang === 'zh' ? '启用单键快捷键（← → / ?）' : 'Use single-key shortcuts (← → / ?)'}</span></label>
      <p class="kbd-help-note">{lang === 'zh' ? '关闭后，随时可以在页脚「键盘快捷键」重新打开。设置只保存在这个浏览器里。' : 'If you turn them off, you can turn them back on from “Keyboard shortcuts” in the footer. The setting is saved in this browser only.'}</p>
    </dialog>

    <script>
      // ---- Keyboard shortcuts: ← → change chapter, / opens search, ? opens the help dialog.
      // Single keys with an off switch (WCAG 2.1.4), saved as localStorage 'kbdShortcuts' = 'off'.
      ;(() => {
        const KEY = 'kbdShortcuts'
        const html = document.documentElement
        const dlg = document.getElementById('kbd-help') as HTMLDialogElement | null
        const box = document.getElementById('kbd-enabled') as HTMLInputElement | null
        const prev = document.querySelector<HTMLAnchorElement>('.pager a[rel="prev"]')
        const next = document.querySelector<HTMLAnchorElement>('.pager a[rel="next"]')
        const searchHref = document.querySelector<HTMLAnchorElement>('.main-nav a[href$="/search/"]')?.href
        let on = true
        try { on = localStorage.getItem(KEY) !== 'off' } catch {}
        const apply = () => {
          html.dataset.kbd = on ? 'on' : 'off'
          if (box) box.checked = on
          for (const [a, k] of [[prev, 'ArrowLeft'], [next, 'ArrowRight']] as const) {
            if (!a) continue
            if (on) a.setAttribute('aria-keyshortcuts', k); else a.removeAttribute('aria-keyshortcuts')
          }
        }
        apply()
        document.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => { el.hidden = false })
        box?.addEventListener('change', () => {
          on = box.checked
          try { if (on) localStorage.removeItem(KEY); else localStorage.setItem(KEY, 'off') } catch {}
          apply()
        })
        const openHelp = () => { if (dlg && !dlg.open) dlg.showModal() }
        document.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('[data-kbd-help]')) openHelp()
        })
        // Light dismiss for browsers without <dialog closedby> (click on the backdrop)
        dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close() })

        let lastPointer: Element | null = null
        // Where the reader last clicked: Chrome scrolls that region with ← → even when nothing is focused
        document.addEventListener('pointerdown', (e) => { lastPointer = e.target as Element }, true)

        const TYPING = 'input, textarea, select, [contenteditable]:not([contenteditable="false"]), [role="textbox"], [role="searchbox"], [role="combobox"], [role="slider"], [role="spinbutton"], [role="listbox"], [role="menu"], [role="menubar"], [role="grid"], [role="tablist"], [role="tree"], [role="radiogroup"], video, audio'
        const overlayOpen = () => {
          if (dlg?.open || document.querySelector('dialog[open]')) return true
          if (document.getElementById('menu-panel')?.dataset.open === 'true') return true
          try { if (document.querySelector(':popover-open')) return true } catch {}
          return !!document.querySelector('.term-pop.is-open')
        }
        const inSideScroller = (start: Element | null) => {
          for (let el = start; el && el !== document.body && el !== html; el = el.parentElement) {
            const ox = getComputedStyle(el).overflowX
            if ((ox === 'auto' || ox === 'scroll') && el.scrollWidth > el.clientWidth + 1) return true
          }
          return false
        }
        const blocked = (e: KeyboardEvent) => {
          if (!on || e.defaultPrevented || e.isComposing || e.keyCode === 229 || e.repeat) return true
          if (e.ctrlKey || e.altKey || e.metaKey) return true
          const t = e.target as HTMLElement
          if (t?.isContentEditable || t?.closest?.(TYPING)) return true
          if (overlayOpen()) return true
          const sel = window.getSelection()
          if (sel && !sel.isCollapsed && sel.toString().trim()) return true
          return false
        }
        document.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
            if (e.shiftKey || blocked(e)) return
            const a = e.key === 'ArrowLeft' ? prev : next
            if (!a) return
            const active = document.activeElement
            if (inSideScroller(active && active !== document.body ? active : lastPointer)) return
            if (html.scrollWidth > html.clientWidth + 1) return // page itself scrolls sideways (zoomed in)
            e.preventDefault()
            location.assign(a.href)
          } else if (e.key === '?') {
            if (blocked(e)) return
            e.preventDefault()
            openHelp()
          } else if (e.key === '/') {
            if (blocked(e)) return
            const q = document.getElementById('q') as HTMLInputElement | null
            e.preventDefault()
            if (q) { q.focus(); q.select() } else if (searchHref) location.assign(searchHref + '#q')
          }
        })
      })()

      // ---- Language preference. An explicit choice (language switcher, root links,
      // or the hint below) is saved as localStorage 'lang' and used by the root page.
      // Language pages never auto-redirect; they only offer a dismissible hint.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLElement>('[data-lang-choice]')
        if (a) try { localStorage.setItem('lang', a.dataset.langChoice ?? '') } catch {}
      })
      ;(() => {
        const hint = document.getElementById('lang-hint')
        if (!hint) return
        const here = document.documentElement.lang.toLowerCase().startsWith('zh') ? 'zh' : 'en'
        let saved: string | null = null
        try { saved = localStorage.getItem('lang') } catch { return }
        if (saved === 'zh' || saved === 'en') return
        let pref: string | null = null
        const ls = navigator.languages?.length ? navigator.languages : [navigator.language || '']
        for (const raw of ls) {
          const t = String(raw).toLowerCase()
          if (t === 'zh' || t.startsWith('zh-')) { pref = 'zh'; break }
          if (t === 'en' || t.startsWith('en-')) { pref = 'en'; break }
        }
        if (!pref || pref === here) return
        hint.hidden = false
        hint.querySelector<HTMLButtonElement>('.lang-hint-close')?.addEventListener('click', (e) => {
          try { localStorage.setItem('lang', (e.currentTarget as HTMLElement).dataset.langStay ?? here) } catch {}
          hint.hidden = true
          document.getElementById('main')?.focus({ preventScroll: true })
        })
      })()

      // ---- Keep the reader in the same section when they switch language.
      // Only the in-page language controls on language pages carry a hash;
      // the root path's preference logic is deliberately left unchanged.
      // An anchor that does not exist in the other edition simply lands at
      // the top of the target chapter, which is a safe fallback.
      ;(() => {
        const links = document.querySelectorAll<HTMLAnchorElement>('.lang-switch, .lang-hint-go')
        links.forEach((a) => { a.dataset.baseHref = a.getAttribute('href') ?? '' })
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.lang-switch, .lang-hint-go')
          if (!a?.dataset.baseHref || !location.hash || location.hash === '#') return
          a.setAttribute('href', a.dataset.baseHref + location.hash)
        }, true)
      })()

      // ---- Theme toggle (persisted, respects prefers-color-scheme by default)
      const root = document.documentElement
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')
      const sync = () => toggle?.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark'))
      sync()
      toggle?.addEventListener('click', () => {
        const dark = root.getAttribute('data-theme') !== 'dark'
        if (dark) root.setAttribute('data-theme', 'dark')
        else root.removeAttribute('data-theme')
        try { localStorage.setItem('theme', dark ? 'dark' : 'light') } catch {}
        sync()
      })
      // Follow later OS light/dark changes until the reader picks a theme with the toggle.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let saved: string | null = null
        try { saved = localStorage.getItem('theme') } catch {}
        if (saved) return
        if (e.matches) root.setAttribute('data-theme', 'dark')
        else root.removeAttribute('data-theme')
        sync()
      })

      // ---- Mobile menu: aria-expanded, Esc closes, focus trapped, focus returned
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn')
      const panel = document.getElementById('menu-panel')
      const sheet = panel?.querySelector<HTMLElement>('.menu-sheet')
      const focusables = () =>
        Array.from(sheet?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? []).filter((el) => el.offsetParent !== null)
      function openMenu() {
        if (!panel || !btn) return
        panel.hidden = false
        panel.dataset.open = 'true'
        btn.setAttribute('aria-expanded', 'true')
        document.body.style.overflow = 'hidden'
        const cur = sheet?.querySelector<HTMLElement>('[aria-current="page"]')
        ;(cur ?? focusables()[0])?.focus()
        cur?.scrollIntoView({ block: 'center' })
      }
      function closeMenu(returnFocus = true) {
        if (!panel || !btn) return
        panel.dataset.open = 'false'
        panel.hidden = true
        btn.setAttribute('aria-expanded', 'false')
        document.body.style.overflow = ''
        if (returnFocus) btn.focus()
      }
      btn?.addEventListener('click', () => (panel?.hidden ? openMenu() : closeMenu()))
      panel?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => closeMenu()))
      document.addEventListener('keydown', (e) => {
        if (!panel || panel.hidden) return
        if (e.key === 'Escape') {
          e.preventDefault()
          closeMenu()
        } else if (e.key === 'Tab') {
          const f = focusables()
          if (!f.length) return
          const first = f[0], last = f[f.length - 1]
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus() }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus() }
        }
      })
      window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => { if (m.matches && panel && !panel.hidden) closeMenu(false) })

      // ---- Glossary popovers (<Term>): native popover does open / Esc / light dismiss
      // without JS; here we add aria-expanded, placement, close-on-focus-leave and a
      // fallback for browsers without the popover API. See BUILD-NOTES.md.
      const native = typeof HTMLElement !== 'undefined' && 'popover' in HTMLElement.prototype
      const wide = window.matchMedia('(min-width: 40rem)')
      let openPop: HTMLElement | null = null
      const btnFor = (pop: HTMLElement) => pop.closest('.term')?.querySelector<HTMLButtonElement>('.term-btn') ?? null
      function place(pop: HTMLElement) {
        const b = btnFor(pop)
        if (!b) return
        if (!wide.matches) {
          // Bottom sheet on narrow screens: keep the「?」button visible above it (2.4.11).
          pop.removeAttribute('data-placed'); pop.style.top = ''; pop.style.left = ''
          requestAnimationFrame(() => {
            const r = b.getBoundingClientRect(), sheetTop = window.innerHeight - pop.offsetHeight
            if (r.bottom > sheetTop - 8) window.scrollBy({ top: r.bottom - sheetTop + 16, behavior: 'instant' as ScrollBehavior })
            else if (r.top < 72) window.scrollBy({ top: r.top - 88, behavior: 'instant' as ScrollBehavior })
          })
          return
        }
        pop.setAttribute('data-placed', '')
        const r = b.getBoundingClientRect(), w = pop.offsetWidth, h = pop.offsetHeight, m = 12
        let left = Math.min(Math.max(m, r.left + r.width / 2 - w / 2), window.innerWidth - w - m)
        let top = r.bottom + 8
        if (top + h > window.innerHeight - m && r.top - 8 - h > m) top = r.top - 8 - h
        pop.style.left = `${Math.round(left)}px`
        pop.style.top = `${Math.round(Math.max(m, top))}px`
      }
      function setOpen(pop: HTMLElement, open: boolean) {
        btnFor(pop)?.setAttribute('aria-expanded', String(open))
        if (open) { openPop = pop; place(pop) } else if (openPop === pop) openPop = null
      }
      document.querySelectorAll<HTMLElement>('.term').forEach((term) => {
        const b = term.querySelector<HTMLButtonElement>('.term-btn')
        const pop = term.querySelector<HTMLElement>('.term-pop')
        if (!b || !pop) return
        b.setAttribute('aria-expanded', 'false')
        if (native) {
          pop.addEventListener('toggle', (e) => setOpen(pop, (e as ToggleEvent).newState === 'open'))
        } else {
          // Fallback: class-based disclosure (CSS hides .term-pop unless .is-open).
          const show = (v: boolean) => { if (v && openPop && openPop !== pop) { openPop.classList.remove('is-open'); setOpen(openPop, false) } pop.classList.toggle('is-open', v); setOpen(pop, v) }
          b.addEventListener('click', () => show(!pop.classList.contains('is-open')))
          term.querySelector('.term-close')?.addEventListener('click', () => { show(false); b.focus() })
          term.addEventListener('keydown', (e) => { if (e.key === 'Escape' && pop.classList.contains('is-open')) { show(false); b.focus() } })
          document.addEventListener('click', (e) => { if (pop.classList.contains('is-open') && !term.contains(e.target as Node)) show(false) })
        }
        // Close when keyboard focus moves somewhere else on the page (not when the window blurs).
        term.addEventListener('focusout', (e) => {
          const to = (e as FocusEvent).relatedTarget as Node | null
          if (!to || term.contains(to)) return
          if (native) { try { pop.hidePopover() } catch {} } else if (pop.classList.contains('is-open')) { pop.classList.remove('is-open'); setOpen(pop, false) }
        })
      })
      let raf = 0
      const reflow = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => { if (openPop && wide.matches) place(openPop) }) }
      window.addEventListener('scroll', reflow, { passive: true })
      window.addEventListener('resize', () => { if (openPop) place(openPop) })

      // ---- Copy code as plain text. Controls sit outside <pre> so they cannot
      // overlap long lines or become part of the copied code. No JS: select as usual.
      const copyZh = document.documentElement.lang.startsWith('zh')
      document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre, i) => {
        const code = pre.querySelector('code')
        if (!code) return
        const bar = document.createElement('div')
        bar.className = 'code-tools'
        bar.dataset.pagefindIgnore = ''
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'copy-btn code-copy'
        button.textContent = copyZh ? '复制代码' : 'Copy code'
        button.dataset.copy = code.textContent ?? ''
        button.dataset.done = copyZh ? '已复制' : 'Copied'
        button.setAttribute('aria-label', copyZh ? `复制代码：第 ${i + 1} 段` : `Copy code block ${i + 1}`)
        bar.appendChild(button)
        pre.before(bar)
      })

      // ---- Shared clipboard handler. The visible label never changes: success
      // adds a small mark and the live region announces a short status, never
      // the copied text. A per-button sequence number makes rapid clicks and a
      // retry after failure safe: stale timeouts cannot reset a newer result.
      // Without JavaScript the code is still selectable by hand.
      const live = document.createElement('div')
      live.className = 'visually-hidden'
      live.setAttribute('aria-live', 'polite')
      document.body.appendChild(live)
      const seq = new WeakMap<HTMLButtonElement, number>()
      document.addEventListener('click', async (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn')
        if (!b) return
        const mine = (seq.get(b) ?? 0) + 1
        seq.set(b, mine)
        b.classList.remove('is-copied', 'is-failed')
        b.removeAttribute('title')
        const v = b.dataset.copy ?? ''
        let copied = false
        try { await navigator.clipboard.writeText(v); copied = true } catch {
          const ta = document.createElement('textarea')
          ta.value = v
          ta.setAttribute('aria-label', copyZh ? '待复制内容' : 'Text to copy')
          ta.style.cssText = 'position:fixed;left:-9999px;top:0'
          document.body.appendChild(ta)
          try { ta.select(); copied = document.execCommand('copy') } catch {} finally { ta.remove(); b.focus({ preventScroll: true }) }
        }
        if (seq.get(b) !== mine) return // a newer click or retry superseded this one
        if (!copied) {
          b.classList.add('is-failed')
          b.setAttribute('title', copyZh ? '复制失败，请手动选择文本' : 'Copy failed. Select the text manually.')
          live.textContent = copyZh ? '复制失败，请手动选择并复制。' : 'Copy failed. Please select and copy the text manually.'
          setTimeout(() => { if (seq.get(b) === mine) b.classList.remove('is-failed') }, 2500)
          return
        }
        b.classList.add('is-copied')
        live.textContent = b.classList.contains('code-copy')
          ? (copyZh ? '代码已复制。粘贴前请核对占位符与网络。' : 'Code copied. Check placeholders and the network before pasting.')
          : (b.dataset.done ?? (copyZh ? '已复制' : 'Copied'))
        setTimeout(() => { if (seq.get(b) === mine) b.classList.remove('is-copied') }, 1500)
      })
    </script>
  </body>
</html>
